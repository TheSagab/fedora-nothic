# Terra (https://terrapkg.com), pinned to the origin instead of the metalink.
#
# This file replaces the /etc/yum.repos.d/terra.repo that the terra-release RPM
# installs. Everything else about it is left as Terra ships it, including
# gpgcheck=1 and repo_gpgcheck=1.
#
# The reason is the metalink. It advertises the checksum of the *current*
# repomd.xml, but the mirrors behind it lag by several metadata revisions, and
# dnf only tries a couple of them before giving up. Measured on 2026-09-23, of
# the six mirrors the metalink offered, five served a stale repomd.xml and one
# (mirror.funami.tech) answered with an HTTP/2 stream error:
#
#   >>> Downloading successful, but checksum doesn't match.
#       Calculated: 477d949d... Expected: d64287b0...
#       - https://mirror.freedif.org/ultramarine/terra44/repodata/repomd.xml
#   >>> repomd.xml GPG signature verification error: Signing key not found
#
# That second line is a red herring, and a nasty one: nothing is wrong with the
# signature. gpg verifies repomd.xml.asc against RPM-GPG-KEY-terra44 (Good
# signature from "Terra 44 <security@fyralabs.com>", fingerprint
# AE09157A4DE88B497EA1D5D300CDAB43DE226D6F), and once dnf has a repomd.xml it
# accepts, repo_gpgcheck=1 passes. The message only means dnf never got one, and
# then reports the last thing that went wrong rather than the first.
#
# repos.fyralabs.com is the origin whose repomd.xml the metalink checksums, so it
# is by definition always current: with baseurl pinned there, both
# repo_gpgcheck=1 and repo_gpgcheck=0 load the repository and install from it,
# and the failure above disappears.
#
# To go back to what Terra ships, delete this file from files/system/ and let
# terra-release's own copy stand. If Terra ever moves off repos.fyralabs.com,
# this file is what has to be updated.

[terra]
name=Terra $releasever
baseurl=https://repos.fyralabs.com/terra$releasever
metadata_expire=6h
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever
repo_gpgcheck=1
enabled=1
enabled_metadata=1
# Terra's anonymous download counter, kept as Terra ships it. Set to 0 to opt out.
countme=1

[terra-source]
name=Terra $releasever - Source
baseurl=https://repos.fyralabs.com/terra$releasever-source
metadata_expire=6h
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever-source
repo_gpgcheck=1
enabled=0
enabled_metadata=0
